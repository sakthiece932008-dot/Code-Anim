# GEMINI_API_KEY: Server-side API key for Gemini AI Simulation, simple-English explanations, and error help.
# Never expose this key to the browser.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: HTTP port for the Express + Vite server (default: 3000).
PORT=3000

# NODE_ENV: Set to "production" when serving the compiled dist/ build.
NODE_ENV="development"

# APP_URL: Optional public URL where this application is hosted.
APP_URL="MY_APP_URL"
